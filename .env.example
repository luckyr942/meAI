# ╔══════════════════════════════════════════════════════════╗
# ║  MeAI Engine — Environment Variables                    ║
# ║  Copy this file to .env and fill in your values         ║
# ╚══════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════
# CHOOSE YOUR AI PROVIDER (pick ONE — or use multiple!)
# ═══════════════════════════════════════════════════════════
#
# MeAI auto-detects which provider to use in this order:
#   1. Ollama (local)  → if installed, used automatically
#   2. Groq (cloud)    → if GROQ_API_KEY is set
#   3. OpenRouter      → if OPENROUTER_API_KEY is set
#
# ── OPTION A: Groq (EASIEST — free, 30 sec signup) ───────
# Get your free key at: https://console.groq.com
# No credit card needed. Fast responses.
GROQ_API_KEY=

# ── OPTION B: Ollama (MOST PRIVATE — runs on your machine)
# Install: brew install ollama
# Then:    ollama pull llama3.2:3b
# No key needed — MeAI auto-detects Ollama!
# OLLAMA_MODEL=llama3.2:3b

# ── OPTION C: OpenRouter (MOST MODELS — 100+ AI models) ──
# Get your key at: https://openrouter.ai/keys
# Many free models available!
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ═══════════════════════════════════════════════════════════
# SERVER (usually don't need to change)
# ═══════════════════════════════════════════════════════════
ENGINE_PORT=8002
HOST=0.0.0.0
DEBUG=true